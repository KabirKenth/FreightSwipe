# Postgres. On Vercel use the Supabase *transaction pooler* string (port 6543)
# with pgbouncer=true, not the direct connection.
DATABASE_URL=postgresql://user:password@localhost:5432/freightswipe

# openssl rand -base64 32
JWT_SECRET=

# Comma-separated browser origins allowed to send credentialed requests.
# Not needed on the single-domain Vercel deploy.
CORS_ORIGIN=http://localhost:3000
